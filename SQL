-- =========================================
-- FUNCTION UPDATE STOK
-- =========================================

CREATE OR REPLACE FUNCTION update_stok_barang()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    jenis_transaksi VARCHAR(10);
BEGIN

    SELECT jenis
    INTO jenis_transaksi
    FROM transaksi
    WHERE id_transaksi = NEW.id_transaksi;

    IF jenis_transaksi = 'MASUK' THEN

        UPDATE barang
        SET stok = stok + NEW.jumlah
        WHERE id_barang = NEW.id_barang;

    ELSIF jenis_transaksi = 'KELUAR' THEN

        UPDATE barang
        SET stok = stok - NEW.jumlah
        WHERE id_barang = NEW.id_barang;

        IF EXISTS (
            SELECT 1
            FROM barang
            WHERE id_barang = NEW.id_barang
            AND stok < 0
        ) THEN
            RAISE EXCEPTION 'Stok barang tidak mencukupi';
        END IF;

    END IF;

    RETURN NEW;
END;
$$;


-- =========================================
-- TRIGGER UPDATE STOK
-- =========================================

CREATE TRIGGER trigger_update_stok
AFTER INSERT ON detail_transaksi
FOR EACH ROW
EXECUTE FUNCTION update_stok_barang();
