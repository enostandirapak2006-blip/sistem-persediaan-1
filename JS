// =========================================
// FORMAT ANGKA
// =========================================

function formatNumber(number) {

    return new Intl.NumberFormat(
        "id-ID"
    ).format(number);

}


// =========================================
// TANGGAL DEFAULT
// =========================================

function setDefaultDate() {

    const today =
        new Date()
        .toISOString()
        .split("T")[0];


    document.getElementById(
        "tanggalMasuk"
    ).value = today;


    document.getElementById(
        "tanggalKeluar"
    ).value = today;

}


// =========================================
// INITIAL LOAD
// =========================================

document.addEventListener(
    "DOMContentLoaded",
    function() {

        setDefaultDate();

        loadDashboard();

    }
);
