-- =========================================
-- DATABASE SISTEM PERSEDIAAN
-- PostgreSQL / Supabase
-- =========================================

-- Hapus tabel jika ingin melakukan reset
DROP TABLE IF EXISTS detail_transaksi CASCADE;
DROP TABLE IF EXISTS transaksi CASCADE;
DROP TABLE IF EXISTS barang CASCADE;


-- =========================================
-- 1. TABEL BARANG
-- =========================================

CREATE TABLE barang (
    id_barang BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    kode_barang VARCHAR(30) NOT NULL UNIQUE,
    nama_barang VARCHAR(100) NOT NULL,
    kategori VARCHAR(50),
    satuan VARCHAR(20) NOT NULL,
    stok INTEGER NOT NULL DEFAULT 0,
    harga NUMERIC(15,2) NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT stok_tidak_boleh_negatif
        CHECK (stok >= 0),

    CONSTRAINT harga_tidak_boleh_negatif
        CHECK (harga >= 0)
);


-- =========================================
-- 2. TABEL TRANSAKSI
-- =========================================

CREATE TABLE transaksi (
    id_transaksi BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    tanggal DATE NOT NULL DEFAULT CURRENT_DATE,
    jenis VARCHAR(10) NOT NULL,
    keterangan TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT jenis_transaksi_valid
        CHECK (jenis IN ('MASUK', 'KELUAR'))
);


-- =========================================
-- 3. TABEL DETAIL TRANSAKSI
-- =========================================

CREATE TABLE detail_transaksi (
    id_detail BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    id_transaksi BIGINT NOT NULL,
    id_barang BIGINT NOT NULL,

    jumlah INTEGER NOT NULL,
    harga NUMERIC(15,2) NOT NULL DEFAULT 0,

    CONSTRAINT jumlah_harus_positif
        CHECK (jumlah > 0),

    CONSTRAINT harga_detail_tidak_negatif
        CHECK (harga >= 0),

    CONSTRAINT fk_detail_transaksi
        FOREIGN KEY (id_transaksi)
        REFERENCES transaksi(id_transaksi)
        ON DELETE CASCADE,

    CONSTRAINT fk_detail_barang
        FOREIGN KEY (id_barang)
        REFERENCES barang(id_barang)
        ON DELETE RESTRICT
);


-- =========================================
-- INDEX
-- =========================================

CREATE INDEX idx_barang_kode
ON barang(kode_barang);

CREATE INDEX idx_transaksi_tanggal
ON transaksi(tanggal);

CREATE INDEX idx_transaksi_jenis
ON transaksi(jenis);

CREATE INDEX idx_detail_transaksi
ON detail_transaksi(id_transaksi);

CREATE INDEX idx_detail_barang
ON detail_transaksi(id_barang);


